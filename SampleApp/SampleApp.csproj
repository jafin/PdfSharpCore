<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      One target framework rather than the library's two, because "dotnet run" refuses to pick
      between them and this app exists to be easy to run. net8.0 rather than net10.0
      because PdfSharpCore.Test references this project and builds a net8.0 leg, which could not
      reference a net10.0 one. What builds here therefore builds on the lowest framework the library
      supports; the multi-framework matrix stays the test project's job.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      Trimming is deliberately not configured here. MigraDocCore.AotSmokeTest is the project that
      guards trim and AOT, with the analyzers switched on and a native publish that CI actually
      runs. Spectre.Console, System.CommandLine and the MigraDoc renderer would each raise IL2xxx
      warnings that say nothing about this app, and warnings nobody can act on are how people learn
      to ignore the analyzer that matters.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfSharpCore\PdfSharpCore.csproj" />
    <ProjectReference Include="..\PdfSharpCore.Skia\PdfSharpCore.Skia.csproj" />
    <ProjectReference Include="..\MigraDocCore.Rendering\MigraDocCore.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.150.1" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Each demo prints its own source, read back out of this assembly, so what appears on the
      terminal cannot drift from what drew the PDF. The files stay Compile items as well - these
      are the same bytes, every build.

      Embedded rather than copied beside the binary because a referenced project's content items do
      not reach the referencing project's output directory, and PdfSharpCore.Test references this
      one. Embedding also survives publishing and does not care what the working directory is.
    -->
    <EmbeddedResource Include="Demos\**\*.cs" LogicalName="Sources/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
